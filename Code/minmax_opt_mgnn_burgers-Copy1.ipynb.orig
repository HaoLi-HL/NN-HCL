   ],
   "source": [
    "eps0 = 1e-4\n",
    "def smooth_sign(x, eps = eps0):\n",
    "    return 2*jax.nn.sigmoid(x/eps)-1\n",
    "\n",
    "# def u0(x):\n",
    "#     return 0.5 * (smooth_sign(x - 0.4) - smooth_sign(x - 0.6))\n",
    "\n",
    "# def u1(x):\n",
    "#     return 0\n",
    "\n",
    "# def u2(x):\n",
    "#     return 0\n",
    "\n",
    "\n",
    "# Define boundary and initial conditions\n",
    "def u0(x):\n",
    "    # return 2*smooth_sign(x) - 1\n",
    "    # return -0.5*(jnp.sign(x) - 1)\n",
    "    return -jnp.sin(jnp.pi*x)\n",
    "def u_exact(tx):\n",
    "    t, x = tx[0], tx[1]\n",
    "    return u0(x-0.5*t)\n",
    "vec_u_exact = vmap(u_exact)\n",
    "\n",
    "# Boundary at x=-1\n",
    "def u1(x):\n",
    "    return 0\n",
    "\n",
    "# Boundary at x=1\n",
    "def u2(x):\n",
    "    return 0\n",
    "\n",
    "\n",
    "def res_visc(u_quad, u_t, u_x, u_xx, nu, u_exact=0):\n",
    "    return u_t + u_quad*u_x - nu*u_xx\n",
    "\n",
    "def res(u_quad, u_t, u_x):\n",
    "    return u_t + u_quad * u_x\n",
    "\n",
    "# Initialize the optimization problem\n",
    "optProb = MinMaxOptProb(\n",
    "    N_t=16,\n",
    "    N_x=32,\n",
    "    lr_theta=1e-3,\n",
    "    N_bc=100,\n",
    "    N_ic=200,\n",
    "    t_min=0, t_max=1, x_min=-1, x_max=1,\n",
    "    project='minmax_mgnn_burgers_inti_sin',\n",
    "    L1_regularization = 1,\n",
    "    hidden_dims_list=[(40, 40, 40, 40)],\n",
    "    init_lrs=[5e-4, 5e-4, 5e-4, 5e-4], grade_epochs=[50000, 50000, 50000, 50000], decay_rates=[1e-3, 1e-3, 1e-3, 1e-3], init_lr_stage2=1e-3, epoch_stage2=100000, decay_rate_stage2=1e-3,\n",
    "    seed=0,\n",
    "    u0=u0, u1=u1, u2=u2,\n",
    "    nu=0.01,\n",
    "    res_visc=res_visc,\n",
    "    res=res,\n",
    "    N_perturb = 10000,\n",
    "    f_opt_kh=1,\n",
    "    total_grade=1, k=0,\n",
    ")"
   ]
  },
