   "id": "9378063b-21b2-4765-b415-11ea230f3543",
   "metadata": {},
   "source": [
    "This copy is featured with intial gmma = 0.1.\n",
    "We set f_opt_kh = 1, use_a = True and L1_regularization = 1 but not working. We use cosine_decay_schedule for the learning rate.\n",
    "We use uniform sampling to optimize k_h with sigma = 0.1."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "691bf602-f258-4193-81a2-f9714f68ebda",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "# sys.path.insert(0, '../../Utilities/')\n",
    "\n",
    "# from jax.example_libraries import optimizers\n",
    "import jax.numpy as jnp\n",
    "import numpy as np\n",
    "from jax import grad, jit, vmap, value_and_grad, hessian\n",
    "from jax import random\n",
    "from functools import partial\n",
    "import flax.linen as nn\n",
    "import jax\n",
    "import optax\n",
    "import pickle\n",
    "from datetime import datetime\n",
    "import os\n",
    "import numpy as np\n",
    "from scipy import sparse\n",
    "import time\n",
    "from jax import grad, hessian, jit, vmap, pmap\n",
    "from jax.tree_util import tree_leaves\n",
    "from datetime import datetime\n",
    "import matplotlib.pyplot as plt\n",
    "import pickle\n",
    "import flax.linen as nn\n",
    "import optax\n",
    "import optax.tree_utils as otu\n",
    "\n",
    "from minmax_opt_class_mgnn import MinMaxOptProb\n",
    "\n",
    "import os\n",
    "os.environ['ENABLE_PJRT_COMPATIBILITY'] = '1'\n",
    "\n",
    "jax.config.update('jax_platform_name', 'cpu')\n",
    "os.environ['OMP_NUM_THREADS'] = str(os.cpu_count())"
   ]
  },
