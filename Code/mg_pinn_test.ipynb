    "import matplotlib.pyplot as plt\n",
    "import jax.numpy as jnp\n",
    "\n",
    "def plot_simulation_data(simulation_data, M_t=100, M_x=256, t_min=0.0, t_max=1.0, x_min=0.0, x_max=1.0):\n",
    "    \"\"\"\n",
    "    Plot the simulation data over a specified domain [t_min, t_max] x [x_min, x_max],\n",
    "    and include a 1D plot of the data at t = t_max.\n",
    "\n",
    "    Args:\n",
    "        simulation_data: Array of shape (M_t, M_x) containing the data to plot.\n",
    "        M_t: Number of grid points in the t-direction (default: 100).\n",
    "        M_x: Number of grid points in the x-direction (default: 256).\n",
    "        t_min: Minimum value for t (default: 0.0).\n",
    "        t_max: Maximum value for t (default: 1.0).\n",
    "        x_min: Minimum value for x (default: 0.0).\n",
    "        x_max: Maximum value for x (default: 1.0).\n",
    "    \"\"\"\n",
    "    # Ensure simulation_data is a jax array and has the correct shape\n",
    "    simulation_data = jnp.asarray(simulation_data)\n",
    "    if simulation_data.shape != (M_t, M_x):\n",
    "        raise ValueError(f\"Expected simulation_data shape ({M_t}, {M_x}), got {simulation_data.shape}\")\n",
    "\n",
    "    # Create grid for t and x\n",
    "    t_grid = jnp.linspace(t_min, t_max, M_t)\n",
    "    x_grid = jnp.linspace(x_min, x_max, M_x)\n",
    "\n",
    "    # Create figure with two subplots\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))\n",
    "\n",
    "    # 2D color mesh plot\n",
    "    pcm = ax1.pcolormesh(x_grid, t_grid, simulation_data, shading='nearest', cmap='viridis')\n",
    "    fig.colorbar(pcm, ax=ax1, label='Simulation Data')\n",
    "    ax1.set_xlabel('x')\n",
    "    ax1.set_ylabel('t')\n",
    "    ax1.set_title('Simulation Data')\n",
    "\n",
    "    # 1D plot at t = t_max\n",
    "    ax2.plot(x_grid, simulation_data[-1, :])\n",
    "    ax2.set_xlabel('x')\n",
    "    ax2.set_ylabel('Data at $t_{max}$')\n",
    "    ax2.set_title(f'Simulation Data at t = {t_max}')\n",
    "\n",
    "    # Adjust layout and display\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Example usage\n",
    "# Assuming simulation_data is your array of shape (100, 256)\n",
    "# For demonstration, create a sample simulation_data array\n",
    "plot_simulation_data(simulation_data)"
   ]
